---
import Layout from '../layouts/Layout.astro';
---

<Layout title="留言板" description="用 OAuth 登录后即可留言">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  <section class="guestbook fade-in">
    <h1 class="guestbook-title">
      <span class="page-title-accent"></span>
      留言板
    </h1>
    <p class="guestbook-desc">登录后即可留言，你的足迹会永久留在这里。</p>

    <div id="guestbook-app">
      <div id="auth-section">
        <!-- Unauthenticated: provider buttons -->
        <div id="login-options" class="login-options" style="display:none">
          <p class="login-hint">选择登录方式：</p>
          <div id="provider-buttons" class="provider-buttons"></div>
        </div>
        <!-- Authenticated: user info -->
        <div id="user-panel" class="user-panel" style="display:none">
          <img id="user-avatar" class="user-avatar" alt="" width="36" height="36" />
          <span class="user-meta">
            <span id="user-name" class="user-name"></span>
            <span id="user-provider" class="user-provider"></span>
          </span>
          <button id="logout-btn" class="btn-logout">退出</button>
        </div>
        <!-- Loading -->
        <div id="auth-loading" class="auth-loading">检查登录状态...</div>
      </div>

      <!-- Reply context -->
      <div id="reply-context" class="reply-context" style="display:none">
        <span id="reply-to-name"></span>
        <button id="cancel-reply" class="btn-cancel-reply">取消回复</button>
      </div>

      <!-- Comment form (authenticated only) -->
      <div id="form-section" class="form-section" style="display:none">
        <textarea id="message-input" class="message-input" placeholder="支持 Markdown 和 LaTeX ($...$ 和 $$...$$)" maxlength="2000" rows="3"></textarea>
        <div class="form-actions">
          <span id="char-count" class="char-count">0/2000</span>
          <button id="submit-btn" class="btn-primary">发送留言</button>
        </div>
      </div>

      <div id="message-list" class="message-list">
        <div class="loading">加载留言中...</div>
      </div>
    </div>
  </section>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/marked@11/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script>
(() => {
  // Guard: only initialize once (View Transitions re-run scripts)
  if (window.__gb_init) return;
  window.__gb_init = true;

  // ── Markdown + LaTeX renderer ──
  let _mdReady = false;
  function ensureMarked() {
    if (_mdReady) return;
    _mdReady = true;
    if (typeof marked !== 'undefined') {
      marked.use({ gfm: true, breaks: true });
      // Override html renderer to escape raw HTML
      const r = new marked.Renderer();
      r.html = (s) => escapeHtml(s.text || s);
      marked.setOptions({ renderer: r });
    }
  }

  function renderMarkdown(text) {
    if (!text) return '';
    ensureMarked();
    // Step 1: replace LaTeX blocks with placeholders
    const latexBlocks = [];
    let processed = text;
    // $$...$$ blocks
    processed = processed.replace(/\$\$([\s\S]+?)\$\$/g, (_, formula) => {
      latexBlocks.push({ type: 'block', formula: formula.trim() });
      return `\x00LATEX${latexBlocks.length - 1}\x00`;
    });
    // $...$ inline
    processed = processed.replace(/\$([^\$\n]+?)\$/g, (_, formula) => {
      latexBlocks.push({ type: 'inline', formula: formula.trim() });
      return `\x00LATEX${latexBlocks.length - 1}\x00`;
    });
    // Step 2: render markdown
    let html;
    if (typeof marked !== 'undefined') {
      try { html = marked.parse(processed); } catch { html = escapeHtml(processed); }
    } else {
      html = escapeHtml(processed).replace(/\n/g, '<br>');
    }
    // Step 3: replace LaTeX placeholders
    if (typeof katex !== 'undefined') {
      for (let i = 0; i < latexBlocks.length; i++) {
        const lb = latexBlocks[i];
        try {
          const rendered = katex.renderToString(lb.formula, { throwOnError: false, displayMode: lb.type === 'block' });
          html = html.replace(`\x00LATEX${i}\x00`, rendered);
        } catch {
          html = html.replace(`\x00LATEX${i}\x00`, `<code>${escapeHtml(lb.formula)}</code>`);
        }
      }
    } else {
      for (let i = 0; i < latexBlocks.length; i++) {
        const lb = latexBlocks[i];
        html = html.replace(`\x00LATEX${i}\x00`, lb.type === 'block' ? `<pre><code>${escapeHtml(lb.formula)}</code></pre>` : `<code>${escapeHtml(lb.formula)}</code>`);
      }
    }
    return html;
  }

  const API_AUTH = '/.netlify/functions/auth';
  const API_GB = '/.netlify/functions/guestbook';

  // DOM refs
  const loginOptions = document.getElementById('login-options');
  const providerButtons = document.getElementById('provider-buttons');
  const userPanel = document.getElementById('user-panel');
  const userAvatar = document.getElementById('user-avatar');
  const userNameEl = document.getElementById('user-name');
  const userProvider = document.getElementById('user-provider');
  const logoutBtn = document.getElementById('logout-btn');
  const authLoading = document.getElementById('auth-loading');
  const formSection = document.getElementById('form-section');
  const messageInput = document.getElementById('message-input');
  const charCount = document.getElementById('char-count');
  const submitBtn = document.getElementById('submit-btn');
  const messageListEl = document.getElementById('message-list');
  const replyContext = document.getElementById('reply-context');
  const replyToNameEl = document.getElementById('reply-to-name');
  const cancelReplyBtn = document.getElementById('cancel-reply');

  let currentUser = null;
  let sessionToken = null;
  let replyToId = '0';
  let replyToName = '';

  // ── Read token from cookie or sessionStorage ──
  function getToken() {
    // First try sessionStorage (survives page reloads better)
    const stored = sessionStorage.getItem('gb_token');
    if (stored) return stored;
    // Fall back to cookie
    const m = document.cookie.match(/(?:^|;\s*)gb_token=([^;]+)/);
    if (m) {
      const token = decodeURIComponent(m[1]);
      sessionStorage.setItem('gb_token', token);
      return token;
    }
    return '';
  }

  sessionToken = getToken();

  // Helper: auth headers for API calls
  function authHeaders() {
    return sessionToken ? { Authorization: `Bearer ${sessionToken}` } : {};
  }

  // ── Provider Icons (inline SVG, no emoji) ──
  const PROVIDER_ICONS = {
    github: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>',
    gitlab: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M15.97 9.33l-1.59-4.89a.47.47 0 00-.45-.31h-.06a.49.49 0 00-.44.28l-1.12 3.44H4.18L3.07 4.4a.49.49 0 00-.44-.28h-.06a.48.48 0 00-.46.31L.53 9.33a.98.98 0 00.27 1.03l6.91 5.01a.5.5 0 00.59 0l6.9-5.01a.98.98 0 00.27-1.03z"/></svg>',
    google: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8.16 7.27h5.82c.06.3.1.66.1 1.1 0 3.76-2.5 6.42-6.3 6.42A6.64 6.64 0 011.16 8a6.64 6.64 0 016.72-6.72c1.8 0 3.3.66 4.46 1.74l-1.86 1.8a3.83 3.83 0 00-2.6-1 3.88 3.88 0 00-3.88 3.88 3.88 3.88 0 003.88 3.88c2.02 0 3.36-1 3.84-2.44H8.16V7.27z"/></svg>',
    gitee: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm2.16 12.5H5.84v-1.5h4.32v1.5zm0-3H5.84v-1.5h4.32v1.5zM10 6.5H6V5h4v1.5z"/></svg>',
    default: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 4v4l3 2"/></svg>',
  };

  // ── Load Providers ──
  async function loadProviders() {
    try {
      const res = await fetch(`${API_AUTH}?action=providers`, { credentials: 'include' });
      const data = await res.json();
      const providers = data.providers || [];
      if (providers.length > 0) {
        renderProviderButtons(providers);
        loginOptions.style.display = 'block';
      } else {
        // No providers configured — show setup help
        loginOptions.style.display = 'block';
        providerButtons.innerHTML = `
          <div class="setup-guide">
            <p class="setup-title">尚未配置 OAuth 登录</p>
            <p>管理员需要在 Netlify 环境变量中配置至少一个 OAuth 提供商。</p>
            <p>支持 GitHub / Google / GitLab / Gitee，详见 <code>netlify.toml</code>。</p>
          </div>`;
      }
    } catch {
      loginOptions.style.display = 'block';
      providerButtons.innerHTML = '<p class="login-hint">API 未连接。请使用 <code>netlify dev</code> 或部署到 Netlify。</p>';
    }
  }

  function renderProviderButtons(providers) {
    providerButtons.innerHTML = providers.map((p) => {
      const icon = PROVIDER_ICONS[p.key] || PROVIDER_ICONS['default'];
      return `<button class="btn-provider btn-provider-${p.key}" data-provider="${p.key}">
        <span class="btn-provider-icon">${icon}</span>
        <span class="btn-provider-label">${p.name}</span>
      </button>`;
    }).join('');

    providerButtons.querySelectorAll('.btn-provider').forEach((btn) => {
      btn.addEventListener('click', () => {
        const provider = btn.getAttribute('data-provider');
        // Redirect to OAuth flow
        window.location.href = `${API_AUTH}?action=login&provider=${provider}`;
      });
    });
  }

  // ── Auth Check ──
  async function checkAuth() {
    try {
      const res = await fetch(`${API_AUTH}?action=me`, {
        credentials: 'include',
        headers: authHeaders(),
      });
      const data = await res.json();
      if (data.authenticated && data.user) {
        currentUser = data.user;
        showAuthenticatedUI(currentUser);
      } else {
        showUnauthenticatedUI();
      }
    } catch {
      showUnauthenticatedUI();
    }
  }

  function showAuthenticatedUI(user) {
    authLoading.style.display = 'none';
    loginOptions.style.display = 'none';
    userPanel.style.display = 'flex';
    formSection.style.display = 'block';
    userAvatar.src = user.avatar || '';
    userAvatar.style.display = user.avatar ? '' : 'none';
    userNameEl.textContent = user.name;
    userProvider.textContent = `via ${user.provider}`;
  }

  function showUnauthenticatedUI() {
    authLoading.style.display = 'none';
    userPanel.style.display = 'none';
    formSection.style.display = 'none';
    // Ensure login area is visible (loadProviders may still be running)
    if (loginOptions.style.display === 'none') {
      loginOptions.style.display = 'block';
      if (!providerButtons.innerHTML) {
        providerButtons.innerHTML = '<p class="login-hint">加载登录方式中...</p>';
      }
    }
  }

  // ── Logout ──
  logoutBtn.addEventListener('click', () => {
    window.location.href = `${API_AUTH}?action=logout&redirect=/guestbook`;
  });

  // ── Load Messages ──
  let allMessages = [];
  let currentMsgPage = 1;
  const MSG_PER_PAGE = 20;

  async function loadAllMessages() {
    messageListEl.innerHTML = '<div class="loading">加载留言中...</div>';
    let flat = [];
    let page = 1;

    try {
      while (true) {
        const res = await fetch(`${API_GB}?page=${page}&per_page=100`, { credentials: 'include' });
        const data = await res.json();
        if (data.messages) flat = flat.concat(data.messages);
        if (!data.hasMore) break;
        page++;
        if (page > 5) break;
      }
      // Thread: build reply tree from flat list
      const idSet = new Set(flat.map((m) => m.id));
      const replyMap = {};
      const topLevel = [];
      for (const m of flat) {
        if (m.parentId === '0' || !idSet.has(m.parentId)) {
          topLevel.push(m);
        } else {
          if (!replyMap[m.parentId]) replyMap[m.parentId] = [];
          replyMap[m.parentId].push(m);
        }
      }
      allMessages = topLevel.map((m) => ({ ...m, replies: replyMap[m.id] || [] }));
      currentMsgPage = 1;
      renderPage();
    } catch {
      messageListEl.innerHTML = '<div class="error-msg">无法加载留言。API 未连接。</div>';
    }
  }

  function renderPage() {
    const totalPages = Math.ceil(allMessages.length / MSG_PER_PAGE) || 1;
    if (currentMsgPage > totalPages) currentMsgPage = totalPages;
    if (currentMsgPage < 1) currentMsgPage = 1;

    const start = (currentMsgPage - 1) * MSG_PER_PAGE;
    const pageMessages = allMessages.slice(start, start + MSG_PER_PAGE);

    if (!pageMessages.length) {
      messageListEl.innerHTML = '<div class="empty-msg">还没有留言，来写下第一条吧。</div>';
    } else {
      messageListEl.innerHTML = pageMessages.map((m) => renderMessageCard(m, true)).join('');
    }

    // Pagination controls
    let pagEl = document.getElementById('msg-pagination');
    if (!pagEl) {
      pagEl = document.createElement('div');
      pagEl.id = 'msg-pagination';
      pagEl.className = 'msg-pagination';
      messageListEl.after(pagEl);
    }
    if (totalPages <= 1) {
      pagEl.style.display = 'none';
    } else {
      pagEl.style.display = 'flex';
      pagEl.innerHTML = `
        <button class="page-btn" ${currentMsgPage <= 1 ? 'disabled' : ''} id="msg-prev">上一页</button>
        <span class="page-info">${currentMsgPage} / ${totalPages}</span>
        <button class="page-btn" ${currentMsgPage >= totalPages ? 'disabled' : ''} id="msg-next">下一页</button>
      `;
      document.getElementById('msg-prev')?.addEventListener('click', () => { currentMsgPage--; renderPage(); window.scrollTo(0, messageListEl.offsetTop - 80); });
      document.getElementById('msg-next')?.addEventListener('click', () => { currentMsgPage++; renderPage(); window.scrollTo(0, messageListEl.offsetTop - 80); });
    }
  }

  function renderMessageCard(m, isTop) {
    const date = new Date(m.created_at).toLocaleDateString('zh-CN', {
      year: 'numeric', month: 'long', day: 'numeric',
      hour: '2-digit', minute: '2-digit',
    });
    const replyBtn = `<button class="btn-reply" data-id="${m.id}" data-name="${escapeAttr(m.author.name)}">回复</button>`;
    const repliesHtml = (m.replies || []).map((r) => renderMessageCard(r, false)).join('');

    return `
      <div class="message-card${isTop ? '' : ' message-reply'}" id="msg-${m.id}">
        <div class="message-header">
          <span class="message-user">
            ${m.author.avatar ? `<img class="message-avatar" src="${escapeAttr(m.author.avatar)}" alt="" width="32" height="32" />` : ''}
            <span class="message-username">${escapeHtml(m.author.name)}</span>
            <span class="message-provider-tag">${escapeHtml(m.author.provider)}</span>
          </span>
          <span class="message-date">${date}</span>
        </div>
        <div class="message-body">${renderMarkdown(m.body)}</div>
        <div class="message-actions">${replyBtn}</div>
        ${repliesHtml ? `<div class="message-replies">${repliesHtml}</div>` : ''}
      </div>
    `;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function escapeAttr(str) {
    return str.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ── Submit Message ──
  async function submitMessage() {
    const body = messageInput.value.trim();
    if (!body) return;
    submitBtn.disabled = true;
    submitBtn.textContent = '发送中...';

    try {
      const res = await fetch(API_GB, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...authHeaders(),
        },
        credentials: 'include',
        body: JSON.stringify({ message: body, parent_id: replyToId }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '发送失败');
      messageInput.value = '';
      charCount.textContent = '0/2000';
      cancelReply();
      await loadAllMessages();
    } catch (err) {
      alert(err.message || '留言发送失败，请稍后再试。');
    }

    submitBtn.disabled = false;
    submitBtn.textContent = '发送留言';
  }

  messageInput.addEventListener('input', () => {
    const len = messageInput.value.length;
    charCount.textContent = `${len}/2000`;
  });

  submitBtn.addEventListener('click', submitMessage);

  messageInput.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      submitMessage();
    }
  });

  // ── Reply ──
  function replyTo(id, name) {
    replyToId = id;
    replyToName = name;
    replyToNameEl.textContent = `回复 @${name}`;
    replyContext.style.display = 'flex';
    messageInput.focus();
  }

  function cancelReply() {
    replyToId = '0';
    replyToName = '';
    replyContext.style.display = 'none';
  }

  cancelReplyBtn.addEventListener('click', cancelReply);

  // Event delegation for reply buttons (they're rendered dynamically)
  messageListEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-reply');
    if (btn) {
      replyTo(btn.getAttribute('data-id'), btn.getAttribute('data-name'));
    }
  });

  // ── Init ──
  loadProviders();
  checkAuth();
  loadAllMessages();
})();
</script>

<style is:global>
  .guestbook {
    padding: 2rem 0 4rem;
  }

  .guestbook-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--text-bright);
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-title-accent {
    display: inline-block;
    width: 4px;
    height: 1.3em;
    background: linear-gradient(180deg, var(--accent), var(--accent-cyan));
    border-radius: 2px;
  }

  .guestbook-desc {
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  /* ── Auth section ── */
  .login-hint {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .auth-loading {
    font-size: 0.9rem;
    color: var(--text-dim);
    padding: 0.5rem 0;
  }

  /* Provider buttons */
  .provider-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-provider {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-sans);
  }

  .btn-provider:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
    color: var(--text-bright);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--accent-glow);
  }

  .btn-provider-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .btn-provider-github { color: #f0f6fc; }
  .btn-provider-gitlab { color: #fc6d26; }
  .btn-provider-google { color: #4285f4; }
  .btn-provider-gitee { color: #c71d23; }

  .btn-provider:hover .btn-provider-icon {
    color: var(--accent-cyan);
  }

  /* User panel */
  .user-panel {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    object-fit: cover;
  }

  .user-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .user-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-bright);
  }

  .user-provider {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .btn-logout {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-sans);
  }

  .btn-logout:hover {
    color: var(--text-bright);
    border-color: var(--accent);
  }

  /* Form */
  .form-section {
    margin-bottom: 2rem;
  }

  .message-input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    color: var(--text);
    font-family: var(--font-sans);
    resize: vertical;
    min-height: 80px;
    transition: border-color 0.2s;
    line-height: 1.5;
  }

  .message-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .message-input::placeholder {
    color: var(--text-dim);
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.6rem;
  }

  .char-count {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .btn-primary {
