---
import Layout from '../layouts/Layout.astro';
import Comments from '../components/Comments.astro';
---

<Layout title="留言板" description="用 OAuth 登录后即可留言">
  <section class="guestbook fade-in">
    <h1 class="guestbook-title">
      <span class="page-title-accent"></span>
      留言板
    </h1>
    <p class="guestbook-desc">登录后即可留言，你的足迹会永久留在这里。</p>
    <Comments issue="[Guestbook]" />
  </section>
</Layout>

<style is:global>
  .guestbook { padding: 2rem 0 4rem; }

  .guestbook-title {
    font-size: 2.4rem; font-weight: 700; color: var(--text-bright);
    margin-bottom: 0.5rem; letter-spacing: -0.03em;
    display: flex; align-items: center; gap: 0.75rem;
  }

  .page-title-accent {
    display: inline-block; width: 4px; height: 1.3em;
    background: linear-gradient(180deg, var(--accent), var(--accent-cyan));
    border-radius: 2px;
  }

  .guestbook-desc { color: var(--text-dim); margin-bottom: 1.5rem; font-size: 1.05rem; }

  @media (max-width: 768px) { .guestbook-title { font-size: 1.8rem; } .guestbook-desc { font-size: 0.95rem; } }
  @media (max-width: 600px) { .guestbook-title { font-size: 1.5rem; } .guestbook { padding: 1rem 0 2rem; } }
  @media (max-width: 400px) { .guestbook-title { font-size: 1.3rem; } .guestbook-desc { font-size: 0.85rem; } }
</style>
