---
export interface Props {
  issue?: string;
}

const issue = Astro.props.issue || '[Guestbook]';
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />

<div class="comments-widget" data-issue={issue}>
  <div class="comments-auth">
    <div class="comments-login" style="display:none">
      <p class="login-hint">选择登录方式：</p>
      <div class="comments-provider-btns"></div>
    </div>
    <div class="comments-user-panel" style="display:none">
      <img class="comments-user-avatar" alt="" width="32" height="32" />
      <span class="comments-user-meta">
        <span class="comments-user-name"></span>
        <span class="comments-user-provider"></span>
      </span>
      <button class="btn-logout">退出</button>
    </div>
    <div class="comments-auth-loading">检查登录状态...</div>
  </div>

  <div class="comments-reply-ctx" style="display:none">
    <span class="comments-reply-to"></span>
    <button class="btn-cancel-reply">取消回复</button>
  </div>

  <div class="comments-form" style="display:none">
    <textarea class="comments-input" placeholder="支持 Markdown 和 LaTeX" maxlength="2000" rows="3"></textarea>
    <div class="comments-form-actions">
      <span class="comments-char-count">0/2000</span>
      <button class="btn-primary comments-submit">发送</button>
    </div>
  </div>

  <div class="comments-list"><div class="loading">加载中...</div></div>

<script>
  // Pass issue to the main script
  window.__cmts_issue = {issue};
</script>
<script src="https://cdn.jsdelivr.net/npm/marked@11/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script>
(() => {
  // Find the widget that matches this issue
  const issueName = window.__cmts_issue?.issue || '[Guestbook]';
  const root = document.querySelector(`.comments-widget[data-issue="${issueName.replace(/"/g, '\\"')}"]`);
  if (!root || root.dataset.cInit) return;
  root.dataset.cInit = '1';

  const issueName = root.dataset.issue || '[Guestbook]';
  const API_AUTH = '/.netlify/functions/auth';
  const API_GB = `/.netlify/functions/guestbook?issue=${encodeURIComponent(issueName)}`;

  // ── DOM refs (scoped to this component) ──
  const $ = (sel) => root.querySelector(sel);
  const loginOpts = $('.comments-login');
  const providerBtns = $('.comments-provider-btns');
  const userPanel = $('.comments-user-panel');
  const userAvatar = $('.comments-user-avatar');
  const userNameEl = $('.comments-user-name');
  const userProvider = $('.comments-user-provider');
  const logoutBtn = $('.btn-logout');
  const authLoading = $('.comments-auth-loading');
  const formSection = $('.comments-form');
  const messageInput = $('.comments-input');
  const charCount = $('.comments-char-count');
  const submitBtn = $('.comments-submit');
  const messageListEl = $('.comments-list');
  const replyCtx = $('.comments-reply-ctx');
  const replyToEl = $('.comments-reply-to');
  const cancelReplyBtn = $('.btn-cancel-reply');

  let currentUser = null;
  let sessionToken = (() => {
    const stored = sessionStorage.getItem('gb_token');
    if (stored) return stored;
    const m = document.cookie.match(/(?:^|;\s*)gb_token=([^;]+)/);
    if (m) { sessionStorage.setItem('gb_token', m[1]); return m[1]; }
    return '';
  })();

  function authHeaders() { return sessionToken ? { Authorization: `Bearer ${sessionToken}` } : {}; }

  let allMessages = [];
  let currentMsgPage = 1;
  const MSG_PER_PAGE = 20;
  let replyToId = '0';
  let replyToName = '';

  // ── Helpers ──
  function escapeHtml(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function escapeAttr(s) { return s.replace(/"/g, '&quot;'); }

  let _mdReady = false;
  function ensureMarked() {
    if (_mdReady) return; _mdReady = true;
    if (typeof marked !== 'undefined') {
      marked.use({ gfm: true, breaks: true });
      const r = new marked.Renderer();
      r.html = (s) => escapeHtml(s.text || s);
      marked.setOptions({ renderer: r });
    }
  }

  function renderMarkdown(text) {
    if (!text) return '';
    ensureMarked();
    const latexBlocks = [];
    let p = text;
    p = p.replace(/\$\$([\s\S]+?)\$\$/g, (_, f) => { latexBlocks.push({type:'block',formula:f.trim()}); return `\x00L${latexBlocks.length-1}\x00`; });
    p = p.replace(/\$([^\$\n]+?)\$/g, (_, f) => { latexBlocks.push({type:'inline',formula:f.trim()}); return `\x00L${latexBlocks.length-1}\x00`; });
    let html;
    if (typeof marked !== 'undefined') { try { html = marked.parse(p); } catch { html = escapeHtml(p); } }
    else { html = escapeHtml(p).replace(/\n/g, '<br>'); }
    if (typeof katex !== 'undefined') {
      for (let i=0;i<latexBlocks.length;i++) {
        try { html = html.replace(`\x00L${i}\x00`, katex.renderToString(latexBlocks[i].formula,{throwOnError:false,displayMode:latexBlocks[i].type==='block'})); }
        catch { html = html.replace(`\x00L${i}\x00`, `<code>${escapeHtml(latexBlocks[i].formula)}</code>`); }
      }
    }
    return html;
  }

  // ── Provider Icons ──
  const ICONS = {
    github: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>',
    default: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  };

  // ── Auth ──
  async function loadProviders() {
    try {
      const r = await fetch(`${API_AUTH}?action=providers`, {credentials:'include'});
      const d = await r.json();
      const providers = d.providers||[];
      if (providers.length) {
        providerBtns.innerHTML = providers.map(p => `<button class="btn-provider btn-provider-${p.key}" data-p="${p.key}"><span class="btn-provider-icon">${ICONS[p.key]||ICONS.default}</span>${p.name}</button>`).join('');
        providerBtns.querySelectorAll('.btn-provider').forEach(b => b.addEventListener('click', () => { window.location.href = `${API_AUTH}?action=login&provider=${b.dataset.p}`; }));
        loginOpts.style.display = 'block';
      } else {
        loginOpts.style.display = 'block';
        providerBtns.innerHTML = '<p class="login-hint">管理员尚未配置 OAuth 登录。</p>';
      }
    } catch { loginOpts.style.display = 'block'; providerBtns.innerHTML = '<p class="login-hint">API 未连接。</p>'; }
  }

  async function checkAuth() {
    try {
      const r = await fetch(`${API_AUTH}?action=me`, {credentials:'include',headers:authHeaders()});
      const d = await r.json();
      if (d.authenticated&&d.user) { currentUser=d.user; showUser(); }
      else showLogin();
    } catch { showLogin(); }
  }

  function showUser() {
    authLoading.style.display='none'; loginOpts.style.display='none';
    userPanel.style.display='flex'; formSection.style.display='block';
    userAvatar.src=currentUser.avatar||''; userAvatar.style.display=currentUser.avatar?'':'none';
    userNameEl.textContent=currentUser.name; userProvider.textContent=`via ${currentUser.provider}`;
  }

  function showLogin() {
    authLoading.style.display='none'; userPanel.style.display='none'; formSection.style.display='none';
  }

  logoutBtn.addEventListener('click', () => { window.location.href=`${API_AUTH}?action=logout&redirect=/guestbook`; });

  // ── Load Messages ──
  function getPageFromURL() {
    const p = parseInt(new URLSearchParams(location.search).get('page'),10);
    return p>0?p:1;
  }

  async function loadAllMessages() {
    messageListEl.innerHTML='<div class="loading">加载中...</div>';
    let flat=[]; let page=1;
    try {
      while(true) {
        const r = await fetch(`${API_GB}&page=${page}&per_page=100`,{credentials:'include'});
        const d = await r.json();
        if (d.messages) flat=flat.concat(d.messages);
        if (!d.hasMore) break;
        page++; if(page>5) break;
      }
      const idSet = new Set(flat.map(m=>m.id));
      const replyMap={}; const topLevel=[];
      for (const m of flat) {
        if (m.parentId==='0'||!idSet.has(m.parentId)) topLevel.push(m);
        else { if(!replyMap[m.parentId]) replyMap[m.parentId]=[]; replyMap[m.parentId].push(m); }
      }
      function thread(msg) { const reps=(replyMap[msg.id]||[]).map(r=>thread(r)); return {...msg,replies:reps}; }
      allMessages = topLevel.reverse().map(m=>thread(m));
      currentMsgPage = getPageFromURL();
      renderPage();
    } catch { messageListEl.innerHTML='<div class="error-msg">无法加载。</div>'; }
  }

  function renderPage() {
    const tp = Math.ceil(allMessages.length/MSG_PER_PAGE)||1;
    if(currentMsgPage>tp) currentMsgPage=tp;
    const start = (currentMsgPage-1)*MSG_PER_PAGE;
    const pg = allMessages.slice(start,start+MSG_PER_PAGE);
    messageListEl.innerHTML = pg.length ? pg.map(m=>renderCard(m,true)).join('') : '<div class="empty-msg">暂无留言。</div>';

    // URL sync
    const url = new URL(location);
    if(currentMsgPage>1) url.searchParams.set('page',String(currentMsgPage));
    else url.searchParams.delete('page');
    history.replaceState(null,'',url);

    let pag = $('.comments-pagination');
    if(tp<=1) { if(pag) pag.style.display='none'; return; }
    if(!pag) { pag=document.createElement('div'); pag.className='comments-pagination'; messageListEl.after(pag); }
    pag.style.display='flex';
    pag.innerHTML=`<button class="page-btn" ${currentMsgPage<=1?'disabled':''} id="cp-prev">上一页</button><span class="page-info">${currentMsgPage}/${tp}</span><button class="page-btn" ${currentMsgPage>=tp?'disabled':''} id="cp-next">下一页</button>`;
    document.getElementById('cp-prev')?.addEventListener('click',()=>{currentMsgPage--;renderPage();});
    document.getElementById('cp-next')?.addEventListener('click',()=>{currentMsgPage++;renderPage();});
  }

  function renderCard(m, isTop) {
    const date = new Date(m.created_at).toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});
    const isOwn = currentUser&&currentUser.name===m.author.name&&currentUser.provider===m.author.provider;
    const isAdmin = currentUser&&currentUser.name==='WaterMagent';
    const delBtn = (isOwn||isAdmin)?`<button class="btn-delete" data-id="${m.id}" data-name="${escapeAttr(m.author.name)}">删除</button>`:'';
    const cb = isAdmin?`<input type="checkbox" class="cb-delete" data-id="${m.id}" />`:'';
    const replyCount = (m.replies||[]).length;
    let rs='';
    if(replyCount>0) {
      rs=`<button class="btn-toggle-replies" data-id="${m.id}">查看 ${replyCount} 条回复</button><div class="message-replies" id="replies-${m.id}" style="display:none">${m.replies.map(r=>renderCard(r,false)).join('')}</div>`;
    }
    return `<div class="message-card${isTop?'':' message-reply'}" id="msg-${m.id}"><div class="message-header"><span class="message-user">${cb}${m.author.avatar?`<img class="message-avatar" src="${escapeAttr(m.author.avatar)}" width="32" height="32" />`:''}<span class="message-username">${escapeHtml(m.author.name)}</span><span class="message-provider-tag">${escapeHtml(m.author.provider)}</span></span><span class="message-date">${date}</span></div><div class="message-body">${renderMarkdown(m.body)}</div><div class="message-actions"><button class="btn-reply" data-id="${m.id}" data-name="${escapeAttr(m.author.name)}">回复</button>${delBtn}</div>${rs}</div>`;
  }

  // ── Submit ──
  async function doSubmit() {
    const body=messageInput.value.trim(); if(!body) return;
    submitBtn.disabled=true; submitBtn.textContent='发送中...';
    try {
      const r=await fetch(API_GB,{method:'POST',headers:{'Content-Type':'application/json',...authHeaders()},credentials:'include',body:JSON.stringify({message:body,parent_id:replyToId})});
      const d=await r.json(); if(!r.ok) throw new Error(d.error||'失败');
      messageInput.value=''; charCount.textContent='0/2000'; cancelReply(); await loadAllMessages();
    } catch(e) { alert(e.message); }
    submitBtn.disabled=false; submitBtn.textContent='发送';
  }

  submitBtn.addEventListener('click',doSubmit);
  messageInput.addEventListener('input',()=>{charCount.textContent=`${messageInput.value.length}/2000`;});
  messageInput.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();doSubmit();}});

  function replyTo(id,name) { replyToId=id; replyToName=name; replyToEl.textContent=`回复 @${name}`; replyCtx.style.display='flex'; messageInput.focus(); }
  function cancelReply() { replyToId='0'; replyToName=''; replyCtx.style.display='none'; }
  cancelReplyBtn.addEventListener('click',cancelReply);

  // ── Event delegation ──
  root.addEventListener('click', async e => {
    const r=e.target.closest('.btn-reply'); if(r){ replyTo(r.dataset.id,r.dataset.name); return; }
    const t=e.target.closest('.btn-toggle-replies'); if(t){
      const el=document.getElementById(`replies-${t.dataset.id}`); if(!el) return;
      const hide=el.style.display!=='none'; el.style.display=hide?'none':''; t.textContent=hide?`查看 ${el.children.length} 条回复`:'收起回复'; return;
    }
    const d=e.target.closest('.btn-delete'); if(d){
      if(!confirm(`确定要删除 ${d.dataset.name} 的留言吗？`)) return;
      try { const r=await fetch(`${API_GB}&id=${d.dataset.id}`,{method:'DELETE',headers:authHeaders(),credentials:'include'}); if(!r.ok) throw new Error((await r.json()).error); await loadAllMessages(); } catch(e) { alert(e.message); }
    }
  });

  // ── Batch delete ──
  let selectedIds=new Set();
  root.addEventListener('change', e => {
    if(!e.target.classList.contains('cb-delete')) return;
    if(e.target.checked) selectedIds.add(e.target.dataset.id); else selectedIds.delete(e.target.dataset.id);
    updateBatch();
  });
  function updateBatch() {
    let bar=$('.comments-batch-bar');
    if(!selectedIds.size){ if(bar)bar.style.display='none'; return; }
    if(!bar){ bar=document.createElement('div'); bar.className='comments-batch-bar'; bar.innerHTML=`<span class="batch-count"></span><button class="btn-batch-del">删除所选</button><button class="btn-batch-cancel">取消</button>`; formSection.before(bar); }
    bar.style.display='flex'; bar.querySelector('.batch-count').textContent=`已选 ${selectedIds.size} 条`;
    bar.querySelector('.btn-batch-del').onclick=async()=>{
      if(!confirm(`确定删除 ${selectedIds.size} 条？`)) return;
      try { const r=await fetch(`${API_GB}&ids=${Array.from(selectedIds).join(',')}`,{method:'DELETE',headers:authHeaders(),credentials:'include'}); if(!r.ok) throw new Error((await r.json()).error); selectedIds.clear(); updateBatch(); await loadAllMessages(); } catch(e){alert(e.message);}
    };
    bar.querySelector('.btn-batch-cancel').onclick=()=>{ selectedIds.clear(); root.querySelectorAll('.cb-delete:checked').forEach(c=>c.checked=false); updateBatch(); };
  }

  // ── Init ──
  loadProviders(); checkAuth(); loadAllMessages();
  window.addEventListener('popstate',()=>{const p=getPageFromURL();if(p!==currentMsgPage){currentMsgPage=p;renderPage();}});
})();
</script>

<style is:global>
  .comments-widget { padding: 1rem 0 2rem; }
  .comments-widget .loading, .comments-widget .empty-msg, .comments-widget .error-msg { text-align:center; color:var(--text-dim); padding:2rem 1rem; font-size:.9rem; }
  .comments-list { display:flex; flex-direction:column; gap:.75rem; min-height:60px; }

  /* Auth */
  .comments-auth { margin-bottom:1rem; }
  .comments-auth-loading { font-size:.85rem; color:var(--text-dim); }
  .login-hint { font-size:.85rem; color:var(--text-dim); margin-bottom:.5rem; }
  .comments-provider-btns { display:flex; flex-wrap:wrap; gap:.5rem; }
  .btn-provider { display:inline-flex; align-items:center; gap:.4rem; padding:.5rem .85rem; background:var(--bg-card); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:.85rem; font-weight:500; cursor:pointer; transition:all .2s; font-family:var(--font-sans); }
  .btn-provider:hover { border-color:var(--accent); background:var(--bg-hover); color:var(--text-bright); transform:translateY(-1px); box-shadow:0 4px 16px var(--accent-glow); }
  .btn-provider-icon { display:flex; align-items:center; width:18px; height:18px; }
  .btn-provider-github { color:#f0f6fc; }
  .comments-user-panel { display:flex; align-items:center; gap:.5rem; padding:.6rem .85rem; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); margin-bottom:1rem; }
  .comments-user-avatar { width:32px; height:32px; border-radius:50%; border:1px solid var(--border); object-fit:cover; }
  .comments-user-meta { flex:1; display:flex; flex-direction:column; gap:1px; }
  .comments-user-name { font-weight:600; font-size:.9rem; color:var(--text-bright); }
  .comments-user-provider { font-size:.7rem; color:var(--text-dim); font-family:var(--font-mono); }
  .btn-logout { background:none; border:1px solid var(--border); color:var(--text-dim); padding:.3rem .65rem; border-radius:6px; font-size:.75rem; cursor:pointer; font-family:var(--font-sans); transition:all .2s; }
  .btn-logout:hover { color:var(--text-bright); border-color:var(--accent); }

  /* Reply context */
  .comments-reply-ctx { display:flex; align-items:center; gap:.6rem; padding:.4rem .65rem; margin-bottom:.4rem; background:rgba(108,99,255,.08); border:1px solid rgba(108,99,255,.2); border-radius:6px; font-size:.8rem; color:var(--accent-cyan); }
  .btn-cancel-reply { background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:.75rem; font-family:var(--font-sans); }
  .btn-cancel-reply:hover { color:var(--text-bright); }

  /* Form */
  .comments-form { margin-bottom:1.5rem; }
  .comments-input { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:.65rem .85rem; font-size:.9rem; color:var(--text); font-family:var(--font-sans); resize:vertical; min-height:70px; transition:border-color .2s; line-height:1.5; }
  .comments-input:focus { outline:none; border-color:var(--accent); }
  .comments-input::placeholder { color:var(--text-dim); }
  .comments-form-actions { display:flex; align-items:center; justify-content:space-between; margin-top:.5rem; }
  .comments-char-count { font-size:.75rem; color:var(--text-dim); font-family:var(--font-mono); }
  .btn-primary { display:inline-flex; align-items:center; padding:.55rem 1.1rem; background:var(--accent); color:#fff!important; border:none; border-radius:8px; font-size:.85rem; font-weight:500; cursor:pointer; transition:all .2s; font-family:var(--font-sans); }
  .btn-primary:hover { background:#7b73ff; box-shadow:0 0 20px var(--accent-glow); transform:translateY(-1px); }
  .btn-primary:disabled { opacity:.6; cursor:not-allowed; transform:none; box-shadow:none; }

  /* Messages */
  .message-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:.85rem 1rem; transition:border-color .2s; }
  .message-card:hover { border-color:rgba(108,99,255,.3); }
  .message-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:.5rem; }
  .message-user { display:flex; align-items:center; gap:.4rem; }
  .message-avatar { width:28px; height:28px; border-radius:50%; border:1px solid var(--border); object-fit:cover; }
  .message-username { font-weight:600; font-size:.85rem; color:var(--text-bright); }
  .message-provider-tag { font-size:.6rem; font-family:var(--font-mono); color:var(--accent); background:rgba(108,99,255,.1); border:1px solid rgba(108,99,255,.2); padding:1px 5px; border-radius:4px; }
  .message-date { font-size:.7rem; color:var(--text-dim); font-family:var(--font-mono); }
  .message-body { font-size:.9rem; line-height:1.6; color:var(--text); word-break:break-word; }
  .message-body p { margin:.35rem 0; }
  .message-body p:first-child { margin-top:0; }
  .message-body p:last-child { margin-bottom:0; }
  .message-body ul,.message-body ol { margin:.35rem 0; padding-left:1.4rem; }
  .message-body pre { margin:.4rem 0; padding:.5rem .7rem; background:rgba(5,5,10,.6); border-radius:6px; border:1px solid var(--border); overflow-x:auto; font-size:.8rem; }
  .message-body code { font-family:var(--font-mono); font-size:.85em; }
  .message-body pre code { background:none; padding:0; border:none; }
  .message-body blockquote { border-left:2px solid var(--accent-cyan); padding-left:.65rem; margin:.4rem 0; color:var(--text-dim); }
  .message-body a { color:var(--accent); text-decoration:underline; text-underline-offset:2px; }
  .message-body .katex-display { margin:.4rem 0; overflow-x:auto; }
  .message-actions { display:flex; align-items:center; gap:.2rem; padding-top:.3rem; }
  .btn-reply { background:none; border:1px solid var(--border); color:var(--text-dim); padding:2px 9px; border-radius:4px; font-size:.7rem; cursor:pointer; font-family:var(--font-sans); transition:all .15s; }
  .btn-reply:hover { border-color:var(--accent); color:var(--accent-cyan); }
  .btn-delete { background:none; border:1px solid transparent; color:var(--text-dim); padding:2px 9px; border-radius:4px; font-size:.7rem; cursor:pointer; font-family:var(--font-sans); transition:all .15s; }
  .btn-delete:hover { border-color:#ff4060; color:#ff4060; }
  .btn-toggle-replies { background:none; border:none; color:var(--accent); padding:3px 0; font-size:.73rem; cursor:pointer; font-family:var(--font-sans); margin-top:.2rem; }
  .btn-toggle-replies:hover { color:var(--accent-cyan); }
  .message-replies { margin-top:.4rem; padding-left:1.25rem; border-left:2px solid var(--border); display:flex; flex-direction:column; gap:.4rem; }
  .message-reply { background:rgba(16,16,28,.5); padding:.4rem .65rem; }
  .message-reply .message-header { margin-bottom:.2rem; }
  .message-reply .message-avatar { width:18px; height:18px; }
